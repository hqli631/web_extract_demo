      "input_bytes": 83667,
      "quality": "pending",
      "output": {
        "title": "【乌镇“网事”】习言道｜让更多国家和人民共享互联网发展成果",
        "blocks": [
          {
            "kind": "paragraph",
            "text": "网络空间关乎人类命运，网络空间未来应由世界各国共同开创。习近平总书记多次深入阐述构建网络空间命运共同体的中国方案，强调“让互联网更好造福人民、造福世界”。",
            "xpath": "/html/body/div[6]/div[1]/div[2]/div[2]/div[4]/div[2]/p"
          }
        ],
        "metadata": [
          {
            "kind": "editor",
            "text": "【编辑:刘阳禾】",
            "xpath": "/html/body/div[6]/div[1]/div[2]/div[2]/div[4]/div[2]/div[12]"
          }
        ],
        "excluded": [
          {
